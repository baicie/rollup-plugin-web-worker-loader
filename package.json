{
    "name": "rollup-plugin-web-worker-loader",
    "version": "2.0.0",
    "description": "Rollup/Rolldown plugin to handle Web Workers, Service Workers, Shared Workers, Audio Worklets, and Paint Worklets",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        }
    },
    "repository": "https://github.com/darionco/rollup-plugin-web-worker-loader",
    "author": "Dario Segura",
    "license": "MIT",
    "scripts": {
        "build": "rollup -c rollup.config.ts",
        "build:rolldown": "rolldown -c rolldown.config.ts",
        "lint": "eslint src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "rollup",
        "rollup-plugin",
        "rolldown",
        "webworker",
        "web-worker",
        "worker",
        "audio-worklet",
        "paint-worklet",
        "service-worker",
        "shared-worker"
    ],
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^25.6.0",
        "rollup": "^4.60.2",
        "rolldown": "1.0.0-rc.16",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "rollup": "^1.9.2 || ^2.0.0 || ^3.0.0 || ^4.0.0",
        "rolldown": "^1.0.0-rc.16"
    },
    "peerDependenciesMeta": {
        "rollup": {
            "optional": true
        },
        "rolldown": {
            "optional": true
        }
    }
}
