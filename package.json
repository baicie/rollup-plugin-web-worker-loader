{
  "name": "@baicie/web-worker-inline",
  "type": "module",
  "version": "0.2.2",
  "description": "Web Worker integration for Baicie projects",
  "author": "baicie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/rollup-plugin-web-worker-loader.git"
  },
  "keywords": [
    "rolldown",
    "rolldown-plugin",
    "rollup",
    "rollup-plugin",
    "webworker",
    "web-worker",
    "worker",
    "audio-worklet",
    "paint-worklet",
    "service-worker",
    "shared-worker"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./rolldown": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rolldown.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rolldown.cjs"
      },
      "default": "./dist/rolldown.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rolldown -c rolldown.config.ts -w",
    "build": "rolldown -c rolldown.config.ts",
    "lint": "eslint",
    "fix": "eslint --fix",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "release": "tsx scripts/release.ts",
    "ci-publish": "tsx scripts/publish.ts",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0-rc.16",
    "rollup": "^1.9.2 || ^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@baicie/release": "^0.1.15",
    "@baicie/scripts": "^0.1.2",
    "@baicie/web-worker-inline": "link:./",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rolldown": "1.0.0-rc.16",
    "rolldown-plugin-dts": "^0.23.2",
    "rollup": "^4.60.2",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node -e \"import('@baicie/scripts').then(m => m.verifyCommit())\""
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  }
}
